#!/usr/bin/env zsh

function usage() {
    cat << EOF
Usage: $(basename $0) [-r|--region] [output.mp4]

Records a window or screen region to a video file using ffmpeg.

Options:
  -r, --region    Select a region with the mouse (requires 'slop')
                  Without this flag, select a window by clicking on it

Arguments:
  output.mp4      Output filename (default: output.mp4)

Examples:
  $(basename $0)                    # Record a window to output.mp4
  $(basename $0) recording.mp4      # Record a window to recording.mp4
  $(basename $0) -r screen.mp4      # Record a region to screen.mp4
EOF
    exit 0
}

# Parse command-line options
mode="window"
output=""

while [[ $# -gt 0 ]]; do
    case $1 in
        -h|--help)
            usage
            ;;
        -r|--region)
            mode="region"
            shift
            ;;
        *)
            output="$1"
            shift
            ;;
    esac
done

output="${output:-output.mp4}"

function record() {
    if [[ $geometry =~ ([0-9]+)x([0-9]+)[+]([0-9]+)[+]([0-9]+) ]]; then
        local w=$match[1]
        local h=$match[2]
        local x=$match[3]
        local y=$match[4]
    fi

    if [[ -z $w || -z $h || -z $x || -z $y ]]; then
        echo "failed to parse geometry"
        return 1
    fi

    # ensure width and height are divisible by 2
    if (( w % 2 != 0 || h % 2 != 0 )); then
        echo "Adjusting dimensions for yuv420p encoding (must be divisible by 2)"
        echo "Original: ${w}x${h}"
        # Round down to nearest even number
        w=$(( w - (w % 2) ))
        h=$(( h - (h % 2) ))
        echo "Adjusted: ${w}x${h}"
    fi

    # ensure output file doesn't exist
    if [[ -f $output ]]; then
        echo "Warning: $output already exists"
        read -q "REPLY?Overwrite? (y/n) "
        echo
        [[ $REPLY =~ ^[Yy]$ ]] && rm $output || return 1
    fi

    ffmpeg -f x11grab \
        -video_size ${w}x${h} \
        -framerate 30 \
        -i :0.0+${x},${y} \
        -c:v libx264 \
        -preset medium \
        -crf 23 \
        -pix_fmt yuv420p \
        $output
}


if [[ $mode == "region" ]]; then
    # Check if slop is installed
    if ! command -v slop &> /dev/null; then
        echo "Error: 'slop' is required for region selection but not found"
        echo "Install it with: sudo apt install slop (Ubuntu/Debian) or sudo pacman -S slop (Arch)"
        exit 1
    fi

    echo "select region to record (click and drag)"
    geometry=$(slop -f "%wx%h+%x+%y")
else
    echo "select window to record"
    geometry=$(xwininfo \
        | grep -e '-geometry' \
        | sed --regexp-extended 's/.*geometry[[:space:]]+(.+)/\1/'
    )
fi

record
