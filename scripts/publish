#!/usr/bin/env zsh

set -euo pipefail

# Publish script for tachyonfx using cargo-release
# This script provides a simplified interface to cargo-release with automatic changelog updates

SCRIPT_DIR="$(cd "$(dirname "${(%):-%N}")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"

SCRIPT_PATH=$0

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Helper functions
log_info() {
    echo -e "${GREEN}[INFO]${NC} $1"
}

log_warn() {
    echo -e "${YELLOW}[WARN]${NC} $1"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

# Check if cargo-release is installed
check_cargo_release() {
    if ! command -v cargo-release >/dev/null 2>&1; then
        log_error "cargo-release is not installed. Install it with:"
        log_error "  cargo install cargo-release"
        exit 1
    fi
}

# Get current version from Cargo.toml
get_current_version() {
    grep '^version = ' "$PROJECT_ROOT/Cargo.toml" | sed 's/version = "\(.*\)"/\1/'
}

# Calculate next version based on increment type
calculate_next_version() {
    local current_version="$1"
    local increment_type="$2"
    
    local -a PARTS=(${(s:.:)current_version})
    local major=$PARTS[1]
    local minor=$PARTS[2]
    local patch=$PARTS[3]
    
    case "$increment_type" in
        "patch")
            patch=$((patch + 1))
            ;;
        "minor")
            minor=$((minor + 1))
            patch=0
            ;;
        "major")
            major=$((major + 1))
            minor=0
            patch=0
            ;;
        *)
            log_error "Invalid increment type: $increment_type. Use 'patch', 'minor', or 'major'"
            exit 1
            ;;
    esac
    
    echo "$major.$minor.$patch"
}

# Update changelog with new version (preserves unreleased section)
update_changelog() {
    local new_version="$1"
    local date=$(date +%Y-%m-%d)
    
    # Check if changelog exists
    if [[ ! -f "$PROJECT_ROOT/CHANGELOG.md" ]]; then
        log_warn "CHANGELOG.md not found, skipping changelog update"
        return
    fi
    
    # Check if there's content in unreleased section
    if ! grep -A 10 "^## unreleased" "$PROJECT_ROOT/CHANGELOG.md" | grep -q "^### "; then
        log_warn "No changes found in unreleased section of CHANGELOG.md"
        log_warn "Please add your changes to the unreleased section before releasing"
        return
    fi
    
    # Create a temporary file with the updated changelog
    local temp_file=$(mktemp)
    
    # Read the changelog and update the unreleased section
    awk -v version="$new_version" -v date="$date" '
    /^## unreleased/ {
        print "## unreleased"
        print ""
        print "## tachyonfx " version " - " date
        next
    }
    { print }
    ' "$PROJECT_ROOT/CHANGELOG.md" > "$temp_file"
    
    # Replace the original changelog
    mv "$temp_file" "$PROJECT_ROOT/CHANGELOG.md"
    log_info "Updated CHANGELOG.md with version $new_version"
}

# Show usage
usage() {
    echo "Usage: $SCRIPT_PATH [patch|minor|major] [--dry-run] [--no-publish]"
    echo ""
    echo "This script uses cargo-release to manage releases with automatic changelog updates."
    echo ""
    echo "Options:"
    echo "  patch     Increment patch version (default)"
    echo "  minor     Increment minor version"
    echo "  major     Increment major version"
    echo "  --dry-run Show what would be done without making changes"
    echo "  --no-publish Update version and changelog but don't publish to crates.io"
    echo ""
    echo "Examples:"
    echo "  $SCRIPT_PATH patch                 # 0.15.0 -> 0.15.1"
    echo "  $SCRIPT_PATH minor                 # 0.15.0 -> 0.16.0"
    echo "  $SCRIPT_PATH major                 # 0.15.0 -> 1.0.0"
    echo "  $SCRIPT_PATH patch --dry-run       # Show what would happen"
    echo "  $SCRIPT_PATH minor --no-publish    # Update version but don't publish"
    echo ""
    echo "Requirements:"
    echo "  - cargo-release must be installed: cargo install cargo-release"
    echo "  - Working directory must be clean"
    echo "  - Must be on a git repository"
}

# Main function
main() {
    local increment_type="patch"
    local dry_run=false
    local no_publish=false
    
    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case $1 in
            patch|minor|major)
                increment_type="$1"
                shift
                ;;
            --dry-run)
                dry_run=true
                shift
                ;;
            --no-publish)
                no_publish=true
                shift
                ;;
            -h|--help)
                usage
                exit 0
                ;;
            *)
                log_error "Unknown argument: $1"
                usage
                exit 1
                ;;
        esac
    done
    
    cd "$PROJECT_ROOT"
    
    # Check prerequisites
    check_cargo_release
    
    # Get version information
    local current_version
    current_version=$(get_current_version)
    local next_version
    next_version=$(calculate_next_version "$current_version" "$increment_type")
    
    log_info "Current version: $current_version"
    log_info "Next version: $next_version"
    
    # Build cargo-release arguments
    local -a release_args=("$increment_type")
    
    if [[ "$dry_run" == true ]]; then
        release_args+=(--dry-run)
        log_info "DRY RUN - No changes will be made"
    fi
    
    if [[ "$no_publish" == true ]]; then
        release_args+=(--no-publish)
    fi
    
    # Update changelog before running cargo-release
    if [[ "$dry_run" == false ]]; then
        update_changelog "$next_version"
        
        # Stage the changelog changes
        if [[ -f "CHANGELOG.md" ]]; then
            git add CHANGELOG.md
            log_info "Staged CHANGELOG.md changes"
        fi
    else
        log_info "Would update CHANGELOG.md with version $next_version"
    fi
    
    # Run cargo-release
    log_info "Running cargo-release with args: ${release_args[*]}"
    cargo release "${release_args[@]}"
    
    if [[ "$dry_run" == false ]]; then
        log_info "🎉 Release process completed!"
        if [[ "$no_publish" == false ]]; then
            log_info "Version $next_version has been published to crates.io"
        else
            log_info "Version $next_version is ready. To publish, run:"
            log_info "  cargo publish"
        fi
        log_info "Don't forget to push the tag:"
        log_info "  git push origin tachyonfx-$next_version"
    fi
}

# Run main function
main "$@"
